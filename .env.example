# ==============================================================================
# NEXUS Agent - Environment Variables Template
# Copy this file to .env.local and populate your secret keys
# ==============================================================================

# --- AI / Foundation Model Keys (Bring Your Own Key) ---
# OpenAI API Key for GPT-4o / Reasoning & Embedding (text-embedding-3-small)
OPENAI_API_KEY=

# Anthropic API Key for Claude 3.7 Sonnet / Claude 3.5 Sonnet (Optional)
ANTHROPIC_API_KEY=

# Google Gemini API Key (Optional)
GEMINI_API_KEY=

# --- SAP BTP & S/4HANA Connectivity (Optional) ---
# SAP BTP Subaccount Subdomain (e.g. eu10-stage-sapient-btp)
SAP_BTP_SUBDOMAIN=

# SAP BTP Destination Service Credentials
SAP_BTP_DESTINATION_URL=
SAP_BTP_CLIENT_ID=
SAP_BTP_CLIENT_SECRET=
SAP_BTP_AUTH_URL=

# SAP HANA Vector Cloud Instance (Optional)
SAP_HANA_HOST=
SAP_HANA_PORT=
SAP_HANA_USER=
SAP_HANA_PASSWORD=
